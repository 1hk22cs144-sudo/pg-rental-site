<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>UrbanNest PG Rentals</title>
  <link rel="stylesheet" href="styles.css" />
</head>
<body>
  <header>
    <h1>UrbanNest PG Rentals</h1>
    <nav>
      <a href="#about">About</a>
      <a href="#listings">Listings</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <section class="hero">
    <h2>Find Your Perfect PG Stay</h2>
    <p>Affordable, safe, and comfortable accommodations for students and professionals.</p>
    <a href="#listings" class="btn">Browse Listings</a>
  </section>

  <section id="about" class="info-section">
    <h2>Why Choose Us?</h2>
    <ul>
      <li>✅ Verified Properties</li>
      <li>✅ No Brokerage</li>
      <li>✅ 24/7 Support</li>
    </ul>
  </section>

  <section id="listings" class="cards">
    <h2>Available PGs</h2>
    <div class="card">
      <img src="pg1.jpg" alt="PG Room 1" />
      <h3>Sunrise PG, Koramangala</h3>
      <p>₹8,000/month • Wi-Fi • Meals Included</p>
    </div>
    <div class="card">
      <img src="pg2.jpg" alt="PG Room 2" />
      <h3>GreenStay PG, Indiranagar</h3>
      <p>₹10,500/month • AC Rooms • Laundry</p>
    </div>
    <!-- Add more cards as needed -->
  </section>

  <section id="contact" class="contact-form">
    <h2>Contact Us</h2>
    <form>
      <input type="text" placeholder="Your Name" required />
      <input type="email" placeholder="Email Address" required />
      <textarea placeholder="Your Message"></textarea>
      <button type="submit">Send Message</button>
    </form>
  </section>

  <footer>
    <p>© 2025 UrbanNest PG Rentals. All rights reserved.</p>
  </footer>
</body>
</html>
body {
  margin: 0;
  font-family: 'Segoe UI', sans-serif;
  background: #f9f9f9;
  color: #333;
}

header {
  background: #2c3e50;
  color: white;
  padding: 1rem 2rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

nav a {
  color: white;
  margin-left: 1rem;
  text-decoration: none;
}

.hero {
  background: url('pg-banner.jpg') center/cover no-repeat;
  color: white;
  text-align: center;
  padding: 5rem 2rem;
}

.hero .btn {
  background: #e67e22;
  color: white;
  padding: 0.75rem 1.5rem;
  border: none;
  text-decoration: none;
  font-weight: bold;
  border-radius: 5px;
}

.info-section {
  padding: 2rem;
  background: #ecf0f1;
  text-align: center;
}

.cards {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  padding: 2rem;
  gap: 1.5rem;
}

.card {
  background: white;
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  width: 300px;
  overflow: hidden;
  text-align: center;
}

.card img {
  width: 100%;
  height: 200px;
  object-fit: cover;
}

.contact-form {
  padding: 2rem;
  background: #fff;
  text-align: center;
}

.contact-form form {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  max-width: 400px;
  margin: auto;
}

.contact-form input,
.contact-form textarea {
  padding: 0.75rem;
  border: 1px solid #ccc;
  border-radius: 4px;
}

.contact-form button {
  background: #27ae60;
  color: white;
  padding: 0.75rem;
  border: none;
  border-radius: 4px;
  font-weight: bold;
}

footer {
  background: #2c3e50;
  color: white;
  text-align: center;
  padding: 1rem;
}
